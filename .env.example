# Copy to .env for local (non-Docker) runs. docker-compose.yml sets these itself.
# Configuration is validated at startup by @app/infrastructure/config; a missing or malformed
# value fails the process immediately rather than surfacing as a null three layers in.

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ---
DATABASE_URL=postgres://koinly:koinly@localhost:5432/koinly
DATABASE_POOL_MAX=10

# --- RabbitMQ ---
RABBITMQ_URL=amqp://koinly:koinly@localhost:5672
# Messages held unacknowledged per worker. Bounds in-flight work and provides backpressure.
QUEUE_PREFETCH=4
# Attempts before a message is parked in the dead-letter queue.
QUEUE_MAX_ATTEMPTS=5
# Delay applied by the retry queue before a message is routed back to the main queue.
QUEUE_RETRY_DELAY_MS=5000

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0

# --- Source payloads ---
# Claim-check root: payloadRef on an import is resolved relative to this directory.
# In production this would be an object-storage bucket (see ADR-0010).
FIXTURES_DIR=./fixtures
