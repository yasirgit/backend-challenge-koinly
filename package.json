{
  "name": "koinly-backend-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "smoke": "pnpm build && node scripts/smoke-dist.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test && pnpm smoke",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.test.yml down -v",
    "migrate": "tsx packages/infrastructure/src/db/migrate.cli.ts",
    "seed": "tsx packages/infrastructure/src/db/seed.cli.ts",
    "dev:api": "tsx watch packages/api/src/main.ts",
    "dev:worker": "tsx watch packages/worker/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
